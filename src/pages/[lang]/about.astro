---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Github, Linkedin, Mail } from 'lucide-astro';
import { getTranslation } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' }, props: { locale: 'en' } },
    { params: { lang: 'id' }, props: { locale: 'id' } }
  ];
}

const { locale } = Astro.props as { locale: 'en' | 'id' };
const t = getTranslation(locale);
---

<BaseLayout 
  title={t.about.title} 
  description={locale === 'en' ? "Learn more about Arham Anwar, the Stack Overflow Paladin." : "Pelajari lebih lanjut tentang Arham Anwar, Stack Overflow Paladin."}
  locale={locale}
  showSidebar={false}
>
  <div class="bg-white dark:bg-[#1a1a1a] rounded-md border border-[#e5e5e5] dark:border-[#404040] p-5 md:p-6">
    <!-- Profile Header -->
    <div class="flex flex-col md:flex-row items-start gap-4 mb-4">
      <img 
        src="/profile.jpg" 
        alt="Arham Anwar" 
        class="w-24 h-24 md:w-32 md:h-32 rounded-full object-cover border-4 border-[#3B49DF]"
      />
      <div class="flex-1">
        <h1 class="text-2xl md:text-3xl font-bold text-[#171717] dark:text-white mb-1">
          🛡️ THE STACK-OVERFLOW PALADIN
        </h1>
        <p class="text-sm text-[#575757] dark:text-[#a1a1a1] italic">
          Champion of Copy-Paste & Master of "It Works on My Machine"
        </p>
      </div>
    </div>

    <hr class="border-[#e5e5e5] dark:border-[#404040] my-4" />

    <div class="text-sm text-[#171717] dark:text-[#d4d4d4] space-y-4 mb-6">
      <div>
        <h3 class="font-bold text-[#3B49DF] dark:text-[#a5b4fc] mb-2">👤 SECRET IDENTITY</h3>
        <ul class="text-sm text-[#575757] dark:text-[#a1a1a1] space-y-1">
          <li>• <strong>Alias:</strong> The Debugging Nomad (Wandering through code he didn't write).</li>
          <li>• <strong>Battle Cry:</strong> "Don't touch it! It's load-bearing spaghetti!"</li>
          <li>• <strong>Signature Weapon:</strong> A mechanical keyboard that sounds expensive to mask the sound of silent sobbing.</li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold text-[#3B49DF] dark:text-[#a5b4fc] mb-2">📊 CHARACTER STATS (Scale 1–10)</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-[#575757] dark:text-[#a1a1a1] border-collapse">
            <thead>
              <tr class="border-b border-[#e5e5e5] dark:border-[#404040]">
                <th class="text-left py-2 pr-4 font-semibold text-[#171717] dark:text-white">Attribute</th>
                <th class="text-center py-2 pr-4 font-semibold text-[#171717] dark:text-white">Level</th>
                <th class="text-left py-2 font-semibold text-[#171717] dark:text-white">Description</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-[#e5e5e5] dark:border-[#404040]">
                <td class="py-2 pr-4 font-medium">Typing Speed</td>
                <td class="py-2 pr-4 text-center text-[#3B49DF] dark:text-[#a5b4fc] font-bold">10</td>
                <td class="py-2">Fast enough to generate 100 bugs per minute.</td>
              </tr>
              <tr class="border-b border-[#e5e5e5] dark:border-[#404040]">
                <td class="py-2 pr-4 font-medium">Logic Mastery</td>
                <td class="py-2 pr-4 text-center text-[#3B49DF] dark:text-[#a5b4fc] font-bold">2</td>
                <td class="py-2">Relies entirely on "Trial and Error" (mostly error).</td>
              </tr>
              <tr class="border-b border-[#e5e5e5] dark:border-[#404040]">
                <td class="py-2 pr-4 font-medium">Patience</td>
                <td class="py-2 pr-4 text-center text-[#3B49DF] dark:text-[#a5b4fc] font-bold">10</td>
                <td class="py-2">Can stare at a red screen for 6 hours without blinking.</td>
              </tr>
              <tr class="border-b border-[#e5e5e5] dark:border-[#404040]">
                <td class="py-2 pr-4 font-medium">Imposter Syndrome</td>
                <td class="py-2 pr-4 text-center text-[#3B49DF] dark:text-[#a5b4fc] font-bold">100</td>
                <td class="py-2">Convinced he's just three raccoons in a trench coat.</td>
              </tr>
              <tr>
                <td class="py-2 pr-4 font-medium">Google Search</td>
                <td class="py-2 pr-4 text-center text-[#3B49DF] dark:text-[#a5b4fc] font-bold">99</td>
                <td class="py-2">Can find a 2014 forum post that solves everything.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="font-bold text-[#3B49DF] dark:text-[#a5b4fc] mb-2">🔥 LEGENDARY ABILITIES (ULTIMATE SKILLS)</h3>
        <ul class="text-sm text-[#575757] dark:text-[#a1a1a1] space-y-2">
          <li>• <strong>✨ The Rubber Duck Seance:</strong> Explains a bug to a plastic duck until the duck starts judging his life choices.</li>
          <li>• <strong>🌀 Ghost Patching:</strong> Fixing a critical error by doing absolutely nothing but restarting the IDE and praying to the Silicon Gods.</li>
          <li>• <strong>🛡️ Job Security Protocol:</strong> Writing code so confusing and undocumented that if he gets fired, the entire company's infrastructure collapses like a Jenga tower.</li>
          <li>• <strong>🎭 The "Senior" Mirage:</strong> Looking intensely focused at a terminal filled with scrolling error logs so the boss thinks he's hacking the mainframe.</li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold text-[#3B49DF] dark:text-[#a5b4fc] mb-2">⚠️ CRITICAL WEAKNESSES</h3>
        <ul class="text-sm text-[#575757] dark:text-[#a1a1a1] space-y-2">
          <li>• <strong>Meetings:</strong> Any conversation lasting longer than 15 minutes causes his brain to enter <em>Power Saving Mode</em>.</li>
          <li>• <strong>The Semicolon Trap:</strong> Losing 3 days of his life to a single missing character.</li>
          <li>• <strong>The "Outside":</strong> A legendary place with "Real Sunlight" that is rumored to have terrible UI and no Dark Mode.</li>
        </ul>
      </div>

      <blockquote class="border-l-4 border-[#3B49DF] pl-4 py-2 my-4 bg-[#f5f5f5] dark:bg-[#262626] rounded-r-md">
        <p class="text-base text-[#171717] dark:text-[#d4d4d4] italic font-medium">
          "I don't always test my code, but when I do, I do it in Production. Stay buggy, my friends."
        </p>
      </blockquote>
    </div>

    <hr class="border-[#e5e5e5] dark:border-[#404040] my-6" />

    <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-4">Connect With Me</h2>
    <div class="flex flex-wrap gap-3">
      <a 
        href="https://github.com/arhamcode"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md border border-[#e5e5e5] dark:border-[#404040] text-[#171717] dark:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
      >
        <Github size={18} />
        GitHub
      </a>
      <a 
        href="https://linkedin.com/in/arhamcode"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md border border-[#e5e5e5] dark:border-[#404040] text-[#171717] dark:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
      >
        <Linkedin size={18} />
        LinkedIn
      </a>
      <a 
        href="mailto:arham@arhamcode.com"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-md border border-[#e5e5e5] dark:border-[#404040] text-[#171717] dark:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
      >
        <Mail size={18} />
        Email
      </a>
    </div>
  </div>
</BaseLayout>
