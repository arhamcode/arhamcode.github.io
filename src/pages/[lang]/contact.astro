---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Github, Linkedin, Mail, Twitter } from 'lucide-astro';
import { getTranslation } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' }, props: { locale: 'en' } },
    { params: { lang: 'id' }, props: { locale: 'id' } }
  ];
}

const { locale } = Astro.props as { locale: 'en' | 'id' };
const t = getTranslation(locale);

const socialLinks = [
  { href: 'https://github.com/arhamcode', icon: Github, label: 'GitHub' },
  { href: 'https://twitter.com', icon: Twitter, label: 'Twitter' },
  { href: 'https://linkedin.com/in/arhamcode', icon: Linkedin, label: 'LinkedIn' },
  { href: 'mailto:arham@arhamcode.com', icon: Mail, label: 'Email' }
];
---

<BaseLayout 
  title={locale === 'en' ? 'Contact' : 'Hubungi'} 
  description={locale === 'en' ? "Get in touch with Arham Anwar" : "Hubungi Arham Anwar"}
  locale={locale}
  showSidebar={false}
>
  <div class="bg-white dark:bg-[#1a1a1a] rounded-md border border-[#e5e5e5] dark:border-[#404040] p-5 md:p-6">
    <h1 class="text-2xl md:text-3xl font-bold text-[#171717] dark:text-white mb-2">
      {locale === 'en' ? 'Get In Touch' : 'Hubungi Kami'}
    </h1>
    <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-6">
      {locale === 'en' 
        ? "I'd love to hear from you! Feel free to reach out through any of the channels below."
        : 'Saya ingin mendengar dari Anda! Silakan hubungi melalui saluran di bawah ini.'}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
      {socialLinks.map(link => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 p-4 rounded-md border border-[#e5e5e5] dark:border-[#404040] hover:border-[#3B49DF] dark:hover:border-[#a5b4fc] hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors group"
        >
          <link.icon size={24} class="text-[#575757] dark:text-[#a1a1a1] group-hover:text-[#3B49DF] dark:group-hover:text-[#a5b4fc]" />
          <div>
            <span class="block font-medium text-[#171717] dark:text-white">{link.label}</span>
            <span class="text-xs text-[#575757] dark:text-[#a1a1a1]">
              {link.label === 'Email' ? 'arham@arhamcode.com' : 
               link.label === 'GitHub' ? 'github.com/arhamcode' :
               link.label === 'Twitter' ? '@arhamcode' :
               'linkedin.com/in/arhamcode'}
            </span>
          </div>
        </a>
      ))}
    </div>

    <hr class="border-[#e5e5e5] dark:border-[#404040] my-6" />

    <div class="mb-6">
      <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-3">
        {locale === 'en' ? 'Send a Message' : 'Kirim Pesan'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-4">
        {locale === 'en'
          ? 'For business inquiries or collaboration opportunities, please email me directly at arham@arhamcode.com'
          : 'Untuk pertanyaan bisnis atau peluang kolaborasi, silakan email saya langsung di arham@arhamcode.com'}
      </p>
    </div>

    <div class="bg-[#f5f5f5] dark:bg-[#262626] rounded-md p-4">
      <h3 class="font-medium text-[#171717] dark:text-white mb-2">
        {locale === 'en' ? 'Response Time' : 'Waktu Respons'}
      </h3>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1]">
        {locale === 'en'
          ? 'I typically respond within 24-48 hours. Thank you for your patience!'
          : 'Saya biasanya merespons dalam 24-48 jam. Terima kasih atas kesabaran Anda!'}
      </p>
    </div>

    <hr class="border-[#e5e5e5] dark:border-[#404040] my-6" />

    <div>
      <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-3">
        {locale === 'en' ? 'What I Can Help With' : 'Yang Bisa Saya Bantu'}
      </h2>
      <ul class="text-sm text-[#575757] dark:text-[#a1a1a1] space-y-2">
        <li>• {locale === 'en' ? 'Flutter Development questions and consulting' : 'Pertanyaan dan konsultasi pengembangan Flutter'}</li>
        <li>• {locale === 'en' ? 'Technical writing opportunities' : 'Peluang menulis teknis'}</li>
        <li>• {locale === 'en' ? 'Open source collaboration' : 'Kolaborasi open source'}</li>
        <li>• {locale === 'en' ? 'Speaking engagements and workshops' : 'Pertemuan dan lokakarya'}</li>
        <li>• {locale === 'en' ? 'Bug reports and feature requests' : 'Laporan bug dan permintaan fitur'}</li>
      </ul>
    </div>
  </div>
</BaseLayout>
