---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getTranslation } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' }, props: { locale: 'en' } },
    { params: { lang: 'id' }, props: { locale: 'id' } }
  ];
}

const { locale } = Astro.props as { locale: 'en' | 'id' };
const t = getTranslation(locale);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.filter(p => p.id.startsWith(locale + '/'));
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1, 6);
---

<BaseLayout 
  title={locale === 'en' ? 'Home' : 'Beranda'} 
  description={t.hero.description}
  locale={locale}
>
  <!-- Featured Post -->
  {featuredPost && (
    <section class="mb-6">
      <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-3">Featured</h2>
      <PostCard 
        title={featuredPost.data.title}
        description={featuredPost.data.description}
        slug={featuredPost.id.split('/')[1]}
        pubDate={featuredPost.data.pubDate}
        tags={featuredPost.data.tags}
        locale={locale}
        featured={true}
      />
    </section>
  )}

  <!-- Latest Posts -->
  <section>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-[#171717] dark:text-white">Latest Posts</h2>
      <a href={`/${locale}/blog`} class="text-sm text-[#3B49DF] dark:text-[#a5b4fc] font-medium hover:underline">
        {t.home.viewAll}
      </a>
    </div>
    
    {recentPosts.length > 0 ? (
      <div class="flex flex-col gap-4">
        {recentPosts.map(post => (
          <PostCard 
            title={post.data.title}
            description={post.data.description}
            slug={post.id.split('/')[1]}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            locale={locale}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-[#575757] dark:text-[#a1a1a1]">{t.home.noPosts}</p>
      </div>
    )}
  </section>
</BaseLayout>
