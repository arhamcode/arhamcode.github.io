---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslation } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' }, props: { locale: 'en' } },
    { params: { lang: 'id' }, props: { locale: 'id' } }
  ];
}

const { locale } = Astro.props as { locale: 'en' | 'id' };
const t = getTranslation(locale);
---

<BaseLayout 
  title={locale === 'en' ? 'Terms of Service' : 'Ketentuan Layanan'} 
  description={locale === 'en' ? "Terms of Service for Arham Code Blog" : "Ketentuan Layanan untuk Blog Arham Code"}
  locale={locale}
  showSidebar={false}
>
  <div class="bg-white dark:bg-[#1a1a1a] rounded-md border border-[#e5e5e5] dark:border-[#404040] p-5 md:p-6">
    <h1 class="text-2xl md:text-3xl font-bold text-[#171717] dark:text-white mb-6">
      {locale === 'en' ? 'Terms of Service' : 'Ketentuan Layanan'}
    </h1>

    <div class="prose prose-sm dark:prose-invert max-w-none text-[#171717] dark:text-[#d4d4d4]">
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-4">
        {locale === 'en' 
          ? 'Last updated: March 2025'
          : 'Terakhir diperbarui: Maret 2025'}
      </p>

      <h2 class="text-lg font-bold text-[#171717] dark:text-white mt-6 mb-3">
        {locale === 'en' ? '1. Acceptance of Terms' : '1. Penerimaan Ketentuan'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-3">
        {locale === 'en'
          ? 'By accessing and using this blog, you accept and agree to be bound by the terms and provision of this agreement.'
          : 'Dengan mengakses dan menggunakan blog ini, Anda menerima dan setuju untuk terikat oleh syarat dan ketentuan perjanjian ini.'}
      </p>

      <h2 class="text-lg font-bold text-[#171717] dark:text-white mt-6 mb-3">
        {locale === 'en' ? '2. Content Ownership' : '2. Kepemilikan Konten'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-3">
        {locale === 'en'
          ? 'All content on this blog, including articles, code snippets, and images, is the property of Arham Anwar and is protected by copyright laws.'
          : 'Semua konten di blog ini, termasuk artikel, cuplikan kode, dan gambar, adalah milik Arham Anwar dan dilindungi oleh hukum hak cipta.'}
      </p>

      <h2 class="text-lg font-bold text-[#171717] dark:text-white mt-6 mb-3">
        {locale === 'en' ? '3. Use of Content' : '3. Penggunaan Konten'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-3">
        {locale === 'en'
          ? 'You are free to read and share our articles with proper attribution. However, you may not reproduce our content for commercial purposes without prior written consent.'
          : 'Anda bebas membaca dan membagikan artikel kami dengan atribusi yang tepat. Namun, Anda tidak boleh mereproduksi konten kami untuk tujuan komersial tanpa persetujuan tertulis terlebih dahulu.'}
      </p>

      <h2 class="text-lg font-bold text-[#171717] dark:text-white mt-6 mb-3">
        {locale === 'en' ? '4. User Contributions' : '4. Kontribusi Pengguna'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-3">
        {locale === 'en'
          ? 'This blog does not currently allow user-generated content or comments.'
          : 'Blog ini saat ini tidak memungkinkan konten atau komentar yang dibuat pengguna.'}
      </p>

      <h2 class="text-lg font-bold text-[#171717] dark:text-white mt-6 mb-3">
        {locale === 'en' ? '5. Disclaimer' : '5. Penafian'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-3">
        {locale === 'en'
          ? 'The content provided on this blog is for educational purposes only. We make no warranties about the completeness, reliability, or accuracy of this information.'
          : 'Konten yang disediakan di blog ini hanya untuk tujuan pendidikan. Kami tidak memberikan jaminan tentang kelengkapan, keandalan, atau keakuratan informasi ini.'}
      </p>

      <h2 class="text-lg font-bold text-[#171717] dark:text-white mt-6 mb-3">
        {locale === 'en' ? '6. Limitation of Liability' : '6. Batasan Tanggung Jawab'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-3">
        {locale === 'en'
          ? 'In no event shall Arham Anwar be liable for any loss or damage including without limitation, indirect or consequential loss or damage, arising out of or in connection with the use of this website.'
          : 'Dalam hal apapun, Arham Anwar tidak akan bertanggung jawab atas kehilangan atau kerusakan termasuk tanpa batasan, kerusakan tidak langsung atau konsekuensial, yang timbul dari atau sehubungan dengan penggunaan situs web ini.'}
      </p>

      <h2 class="text-lg font-bold text-[#171717] dark:text-white mt-6 mb-3">
        {locale === 'en' ? '7. Changes to Terms' : '7. Perubahan Ketentuan'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-3">
        {locale === 'en'
          ? 'We reserve the right to modify these terms at any time. Any changes will be posted on this page.'
          : 'Kami berhak untuk mengubah syarat ini kapan saja. Setiap perubahan akan diposting di halaman ini.'}
      </p>

      <h2 class="text-lg font-bold text-[#171717] dark:text-white mt-6 mb-3">
        {locale === 'en' ? '8. Contact Information' : '8. Informasi Kontak'}
      </h2>
      <p class="text-sm text-[#575757] dark:text-[#a1a1a1] mb-3">
        {locale === 'en'
          ? 'If you have any questions about these terms, please contact us at arham@arhamcode.com'
          : 'Jika Anda memiliki pertanyaan tentang ketentuan ini, silakan hubungi kami di arham@arhamcode.com'}
      </p>
    </div>
  </div>
</BaseLayout>
