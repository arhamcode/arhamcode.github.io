---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { ChevronLeft, ChevronRight } from 'lucide-astro';
import { getCollection } from 'astro:content';
import { getTranslation } from '../../../i18n/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const locales = ['en', 'id'];
  const POSTS_PER_PAGE = 6;

  const paths = [];
  for (const locale of locales) {
    const posts = allPosts.filter(p => p.id.startsWith(locale + '/'));
    const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
    
    for (let page = 1; page <= totalPages; page++) {
      paths.push({
        params: { lang: locale, page: page.toString() },
        props: { locale, currentPage: page, totalPages, totalPosts: posts.length }
      });
    }
  }
  return paths;
}

interface Props {
  locale: 'en' | 'id';
  currentPage: number;
  totalPages: number;
  totalPosts: number;
}

const { locale, currentPage, totalPages, totalPosts } = Astro.props;
const t = getTranslation(locale);
const POSTS_PER_PAGE = 6;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.filter(p => p.id.startsWith(locale + '/'));
const allTags = [...new Set(posts.flatMap(post => post.data.tags))];
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const paginatedPosts = sortedPosts.slice(startIndex, startIndex + POSTS_PER_PAGE);

const getPageUrl = (page: number) => {
  if (page === 1) return `/${locale}/blog`;
  return `/${locale}/blog/${page}`;
};
---

<BaseLayout 
  title={t.blog.title}
  description={t.blog.description}
  locale={locale}
>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-[#171717] dark:text-white mb-2">
      {t.blog.title}
    </h1>
    <p class="text-sm text-[#575757] dark:text-[#a1a1a1]">
      {t.blog.description}
    </p>
  </div>

  <!-- Tags -->
  <div class="flex flex-wrap gap-2 mb-6 pb-6 border-b border-[#e5e5e5] dark:border-[#404040]">
    <span class="px-3 py-1 text-sm font-medium rounded-md bg-[#3B49DF] text-white">
      {t.blog.all}
    </span>
    {allTags.map(tag => (
      <a 
        href={`/${locale}/blog/${tag}`}
        class="px-3 py-1 text-sm font-medium rounded-md bg-[#f5f5f5] dark:bg-[#262626] text-[#575757] dark:text-[#a1a1a1] hover:bg-[#eef0ff] dark:hover:bg-[#2d2d2d] hover:text-[#3B49DF] transition-colors"
      >
        #{tag}
      </a>
    ))}
  </div>

  <!-- Posts -->
  {paginatedPosts.length > 0 ? (
    <div class="flex flex-col gap-4">
      {paginatedPosts.map(post => (
        <PostCard 
          title={post.data.title}
          description={post.data.description}
          slug={post.id.split('/')[1]}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          locale={locale}
        />
      ))}
    </div>
  ) : (
    <div class="text-center py-16">
      <p class="text-[#575757] dark:text-[#a1a1a1]">{t.blog.noPosts}</p>
    </div>
  )}

  <!-- Pagination -->
  {totalPages > 1 && (
    <div class="flex items-center justify-between mt-8 pt-6 border-t border-[#e5e5e5] dark:border-[#404040]">
      <div class="text-sm text-[#575757] dark:text-[#a1a1a1]">
        {currentPage} / {totalPages}
      </div>
      <div class="flex items-center gap-2">
        {currentPage > 1 ? (
          <a 
            href={getPageUrl(currentPage - 1)}
            class="flex items-center gap-1 px-3 py-1.5 text-sm font-medium rounded-md border border-[#e5e5e5] dark:border-[#404040] text-[#171717] dark:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
          >
            <ChevronLeft size={16} />
            Previous
          </a>
        ) : (
          <span class="flex items-center gap-1 px-3 py-1.5 text-sm font-medium rounded-md border border-[#e5e5e5] dark:border-[#404040] text-[#71717a] dark:text-[#71717a] cursor-not-allowed opacity-50">
            <ChevronLeft size={16} />
            Previous
          </span>
        )}
        
        {currentPage < totalPages && (
          <a 
            href={getPageUrl(currentPage + 1)}
            class="flex items-center gap-1 px-3 py-1.5 text-sm font-medium rounded-md border border-[#e5e5e5] dark:border-[#404040] text-[#171717] dark:text-white hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
          >
            Next
            <ChevronRight size={16} />
          </a>
        )}
      </div>
    </div>
  )}
</BaseLayout>
