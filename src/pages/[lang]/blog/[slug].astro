---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import { ArrowLeft, Calendar, Tag, Clock } from 'lucide-astro';
import { formatDate, calculateReadingTime } from '../../../utils/readingTime';
import { getTranslation } from '../../../i18n/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const locales = ['en', 'id'];
  
  const paths = [];
  for (const locale of locales) {
    const posts = allPosts.filter(p => p.id.startsWith(locale + '/'));
    
    for (const post of posts) {
      paths.push({
        params: { lang: locale, slug: post.id.split('/')[1] },
        props: { post, locale }
      });
    }
  }
  return paths;
}

const { post, locale } = Astro.props as { post: any, locale: 'en' | 'id' };
const t = getTranslation(locale);
const { Content } = await render(post);
const readingTime = calculateReadingTime(post.body || '');
---

<BaseLayout 
  title={post.data.title} 
  description={post.data.description}
  type="article"
  locale={locale}
  showSidebar={false}
>
  <article class="max-w-none">
    <!-- Back Link -->
    <a 
      href={`/${locale}/blog`} 
      class="inline-flex items-center gap-1.5 text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline mb-6"
    >
      <ArrowLeft size={14} />
      {t.blog.backToBlog}
    </a>

    <!-- Header -->
    <header class="bg-white dark:bg-[#1a1a1a] rounded-md border border-[#e5e5e5] dark:border-[#404040] p-5 mb-6">
      <div class="flex flex-wrap items-center gap-4 text-xs text-[#71717a] dark:text-[#a1a1a1] mb-3">
        <span class="flex items-center gap-1">
          <Calendar size={14} />
          {formatDate(post.data.pubDate)}
        </span>
        <span class="flex items-center gap-1">
          <Clock size={14} />
          {readingTime}
        </span>
      </div>
      
      <h1 class="text-2xl md:text-3xl font-bold text-[#171717] dark:text-white mb-3">
        {post.data.title}
      </h1>
      
      <p class="text-base text-[#575757] dark:text-[#a1a1a1] leading-relaxed mb-4">
        {post.data.description}
      </p>

      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map(tag => (
            <a 
              href={`/${locale}/blog/${tag}`}
              class="text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Content -->
    <div class="bg-white dark:bg-[#1a1a1a] rounded-md border border-[#e5e5e5] dark:border-[#404040] p-5 md:p-6
      prose prose-sm md:prose-base dark:prose-invert max-w-none 
      prose-headings:font-bold prose-headings:text-[#171717] dark:prose-headings:text-white
      prose-h1:text-xl prose-h2:text-lg prose-h3:text-base
      prose-p:text-[#171717] dark:prose-p:text-[#d4d4d4] prose-p:leading-relaxed
      prose-a:text-[#3B49DF] dark:prose-a:text-[#a5b4fc] prose-a:no-underline hover:prose-a:underline
      prose-code:bg-[#f5f5f5] dark:prose-code:bg-[#262626] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[#3B49DF] dark:prose-code:text-[#a5b4fc] prose-code:font-mono prose-code:text-sm
      prose-pre:bg-[#0a0a0a] prose-pre:rounded-md prose-pre:border prose-pre:border-[#404040] prose-pre:p-4
      prose-img:rounded-md
      prose-blockquote:border-l-4 prose-blockquote:border-[#3B49DF] prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-[#575757] dark:prose-blockquote:text-[#a1a1a1]
      prose-ul:list-disc prose-ul:pl-5 prose-ol:list-decimal prose-ol:pl-5
      prose-li:text-[#171717] dark:prose-li:text-[#d4d4d4]
    ">
      <Content />
    </div>

    <!-- Footer -->
    <footer class="mt-6 pt-6 border-t border-[#e5e5e5] dark:border-[#404040]">
      <a 
        href={`/${locale}/blog`} 
        class="inline-flex items-center gap-1.5 text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline font-medium"
      >
        <ArrowLeft size={14} />
        {t.blog.backToBlog}
      </a>
    </footer>
  </article>
</BaseLayout>
