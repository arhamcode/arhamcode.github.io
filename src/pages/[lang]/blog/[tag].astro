---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getTranslation } from '../../../i18n/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const locales = ['en', 'id'];
  
  const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))];
  
  const paths = [];
  for (const locale of locales) {
    const posts = locale === 'en'
      ? allPosts.filter(p => !p.data.lang || p.data.lang === 'en')
      : allPosts.filter(p => p.data.lang === 'id');
    
    for (const tag of allTags) {
      const tagPosts = posts.filter(p => p.data.tags.includes(tag));
      if (tagPosts.length > 0) {
        paths.push({
          params: { lang: locale, tag },
          props: { posts: tagPosts, locale }
        });
      }
    }
  }
  return paths;
}

const { posts, locale } = Astro.props as { posts: any[], locale: 'en' | 'id' };
const { tag } = Astro.params;
const t = getTranslation(locale);

const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title={`${tag} - ${t.blog.title}`}
  description={`Posts tagged with ${tag}`}
  locale={locale}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-12">
      <div class="flex items-center gap-2 mb-4">
        <a href={`/${locale}/blog`} class="text-primary hover:text-primary/80 transition-colors">
          {t.blog.title}
        </a>
        <span class="text-gray-400">/</span>
        <span class="text-gray-600 dark:text-gray-400">{tag}</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-gray-600 dark:text-gray-400">{t.blog.filteringBy}</span>
        <span class="px-3 py-1 text-sm bg-primary/10 text-primary rounded-full">
          {tag}
        </span>
        <a href={`/${locale}/blog`} class="text-sm text-gray-500 hover:text-primary">
          {t.blog.clear}
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map(post => (
        <PostCard 
          title={post.data.title}
          description={post.data.description}
          slug={post.id}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          locale={locale}
        />
      ))}
    </div>
  </div>
</BaseLayout>