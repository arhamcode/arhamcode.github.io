---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getTranslation } from '../../../i18n/utils';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const locales = ['en', 'id'];
  
  const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))];
  
  const paths = [];
  for (const locale of locales) {
    const posts = allPosts.filter(p => p.id.startsWith(locale + '/'));
    
    for (const tag of allTags) {
      const tagPosts = posts.filter(p => p.data.tags.includes(tag));
      if (tagPosts.length > 0) {
        paths.push({
          params: { lang: locale, tag },
          props: { posts: tagPosts, locale }
        });
      }
    }
  }
  return paths;
}

const { posts, locale } = Astro.props as { posts: any[], locale: 'en' | 'id' };
const { tag } = Astro.params;
const t = getTranslation(locale);

const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title={`#${tag} - ${t.blog.title}`}
  description={`Posts tagged with ${tag}`}
  locale={locale}
>
  <div class="mb-6">
    <div class="flex items-center gap-2 mb-4">
      <a href={`/${locale}/blog`} class="text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline">
        {t.blog.title}
      </a>
      <span class="text-[#71717a]">/</span>
      <span class="text-sm text-[#575757] dark:text-[#a1a1a1]">#{tag}</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-sm text-[#575757] dark:text-[#a1a1a1]">{t.blog.filteringBy}</span>
      <span class="px-2.5 py-1 text-xs font-medium bg-[#eef0ff] dark:bg-[#262626] text-[#3B49DF] dark:text-[#a5b4fc] rounded-md">
        #{tag}
      </span>
      <a href={`/${locale}/blog`} class="text-xs text-[#71717a] dark:text-[#a1a1a1] hover:text-[#3B49DF]">
        {t.blog.clear}
      </a>
    </div>
  </div>

  <div class="flex flex-col gap-4">
    {sortedPosts.map(post => (
      <PostCard 
        title={post.data.title}
        description={post.data.description}
        slug={post.id.split('/')[1]}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        locale={locale}
      />
    ))}
  </div>
</BaseLayout>
