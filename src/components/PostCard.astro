---
import { Calendar } from 'lucide-astro';
import { formatDate } from '../utils/readingTime';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  tags?: string[];
  locale?: string;
  featured?: boolean;
}

const { title, description, slug, pubDate, tags = [], locale = 'en', featured = false } = Astro.props;
---

<a 
  href={`/${locale}/blog/${slug}`}
  class:list={[
    "group flex flex-col bg-white dark:bg-[#1a1a1a] rounded-md border border-[#e5e5e5] dark:border-[#404040] hover:border-[#3B49DF] dark:hover:border-[#a5b4fc] transition-all duration-200 p-4",
    featured ? "md:flex-row md:p-0" : ""
  ]}
>
  {featured && (
    <div class="md:w-1/3 h-40 md:h-auto bg-gradient-to-br from-[#3B49DF] to-[#5c2d91] md:rounded-l-md"></div>
  )}
   
  <div class:list={[
    "flex-1",
    featured ? "md:p-4" : ""
  ]}>
    <div class="flex items-center gap-2 text-xs text-[#71717a] dark:text-[#a1a1a1] mb-2">
      <Calendar size={12} />
      <span>{formatDate(pubDate)}</span>
    </div>

    <h3 class:list={[
      "font-bold text-[#171717] dark:text-white group-hover:text-[#3B49DF] dark:group-hover:text-[#a5b4fc] transition-colors",
      featured ? "text-xl mb-3" : "text-base mb-2"
    ]}>
      {title}
    </h3>

    <p class="text-sm text-[#575757] dark:text-[#a1a1a1] line-clamp-2 mb-3">
      {description}
    </p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-[#575757] dark:text-[#a1a1a1]">
        {tags.slice(0, 4).map(tag => (
          <span class="hover:bg-[#f5f5f5] dark:hover:bg-[#262626] px-1 rounded transition-colors">
            <span class="text-[#3B49DF] dark:text-[#a5b4fc]">#</span>{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
