---
interface Props {
  currentLocale: string;
}

const { currentLocale } = Astro.props;
const currentPath = Astro.url.pathname.replace(/^\/(en|id)/, '') || '/';

const locales = [
  { code: 'en', label: 'English' },
  { code: 'id', label: 'Bahasa' }
];

function getLocalePath(localeCode: string): string {
  if (localeCode === 'en') {
    return currentPath === '/' ? '/' : currentPath;
  }
  return `/${localeCode}${currentPath === '/' ? '' : currentPath}`;
}
---

<div class="relative inline-flex" id="language-picker-container">
  <button 
    id="language-toggle"
    class="flex items-center gap-1 px-3 py-1.5 text-sm rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
    aria-label="Select language"
  >
    <span class="uppercase">{currentLocale}</span>
  </button>
  
  <div 
    id="language-menu"
    class="absolute right-0 mt-2 w-28 py-2 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 hidden z-50"
  >
    {locales.map(locale => (
      <a
        href={getLocalePath(locale.code)}
        class:list={[
          "block px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors",
          currentLocale === locale.code ? "text-primary font-medium" : "text-gray-700 dark:text-gray-300"
        ]}
      >
        {locale.label}
      </a>
    ))}
  </div>
</div>

<script>
  const toggle = document.getElementById('language-toggle');
  const menu = document.getElementById('language-menu');
  
  if (toggle && menu) {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });
    
    document.addEventListener('click', () => {
      menu.classList.add('hidden');
    });
  }
</script>