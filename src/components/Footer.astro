---
import { Github, Twitter, Linkedin, Mail } from 'lucide-astro';
import { getTranslation, type Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslation(locale);

const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: 'https://github.com/arhamcode', icon: Github, label: 'GitHub' },
  { href: 'https://twitter.com', icon: Twitter, label: 'Twitter' },
  { href: 'https://linkedin.com/in/arhamcode', icon: Linkedin, label: 'LinkedIn' },
  { href: 'mailto:arham@arhamcode.com', icon: Mail, label: 'Email' }
];
---

<footer class="bg-white dark:bg-[#1a1a1a] border-t border-[#e5e5e5] dark:border-[#404040] mt-auto">
  <div class="max-w-[1280px] mx-auto px-3 md:px-5 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex flex-col md:flex-row items-center gap-2 text-sm text-[#575757] dark:text-[#a1a1a1]">
        <span>&copy; {currentYear} Arham Anwar.</span>
        <span class="hidden md:inline">All rights reserved.</span>
      </div>

      <div class="flex items-center gap-3">
        {socialLinks.map(link => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="p-1.5 rounded text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626] hover:text-[#3B49DF] transition-colors"
            aria-label={link.label}
          >
            <link.icon size={18} />
          </a>
        ))}
      </div>
    </div>
    
    <div class="mt-6 text-center text-xs text-[#71717a] dark:text-[#71717a]">
      Built with <a href="https://astro.build" class="text-[#3B49DF] hover:underline">Astro</a> &bull; 
      Design inspired by <a href="https://dev.to" class="text-[#3B49DF] hover:underline">DEV.to</a>
    </div>
  </div>
</footer>
