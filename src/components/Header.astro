---
import { Sun, Moon, Github, Menu, Search, Bell, Plus, User } from 'lucide-astro';
import LanguagePicker from './LanguagePicker.astro';
import { getTranslation, type Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getTranslation(locale);

const currentLocale = locale;
const getNavHref = (path: string) => {
  if (currentLocale === 'en') return path;
  return `/${currentLocale}${path === '/' ? '' : path}`;
};

const navItems = [
  { href: '/', label: t.nav.home },
  { href: '/blog', label: t.nav.blog },
  { href: '/about', label: t.nav.about }
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white dark:bg-[#1a1a1a] border-b border-[#e5e5e5] dark:border-[#404040]">
  <div class="max-w-[1280px] mx-auto px-3 md:px-5">
    <div class="flex items-center justify-between h-12">
      <!-- Left: Logo & Nav -->
      <div class="flex items-center gap-3">
        <!-- Mobile menu button -->
        <button 
          id="mobile-menu-toggle"
          class="lg:hidden p-1.5 rounded-md text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
          aria-label="Toggle menu"
        >
          <Menu size={20} />
        </button>

        <!-- Logo -->
        <a href={getNavHref('/')} class="flex items-center gap-2 font-bold text-lg text-[#171717] dark:text-white hover:opacity-80 transition-opacity">
          <div class="w-8 h-8 bg-[#3B49DF] rounded flex items-center justify-center">
            <span class="text-white text-sm font-bold">arh</span>
          </div>
          <span class="hidden sm:block">arhamcode</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-1 ml-4">
          {navItems.map(item => (
            <a 
              href={getNavHref(item.href)}
              class:list={[
                "px-3 py-1.5 text-sm font-medium rounded-md transition-colors",
                currentPath === item.href || currentPath.startsWith(item.href + '/')
                  ? "bg-[#eef0ff] dark:bg-[#2d2d2d] text-[#3B49DF]"
                  : "text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626]"
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Center: Search -->
      <div class="hidden md:flex flex-1 max-w-lg mx-4">
        <div class="relative w-full">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <Search size={16} class="text-[#71717a]" />
          </div>
          <input 
            type="text" 
            placeholder="Search..."
            class="w-full pl-9 pr-4 py-1.5 text-sm bg-[#f5f5f5] dark:bg-[#262626] border border-[#e5e5e5] dark:border-[#404040] rounded-md text-[#171717] dark:text-white placeholder-[#71717a] focus:outline-none focus:ring-2 focus:ring-[#3B49DF] focus:border-transparent"
          />
        </div>
      </div>

      <!-- Right: Actions -->
      <div class="flex items-center gap-1">
        <!-- Mobile Search -->
        <button 
          class="md:hidden p-1.5 rounded-md text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
          aria-label="Search"
        >
          <Search size={18} />
        </button>

        <!-- Create Post Button -->
        <a 
          href="#"
          class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-[#3B49DF] hover:bg-[#eef0ff] dark:hover:bg-[#2d2d2d] rounded-md transition-colors"
        >
          <Plus size={16} />
          <span class="hidden md:inline">Post</span>
        </a>

        <!-- Theme Toggle -->
        <button 
          id="theme-toggle" 
          class="p-1.5 rounded-md text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
          aria-label="Toggle theme"
        >
          <Sun class="hidden dark:block" size={18} />
          <Moon class="block dark:hidden" size={18} />
        </button>

        <!-- GitHub -->
        <a 
          href="https://github.com/arhamcode" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-1.5 rounded-md text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
          aria-label="GitHub"
        >
          <Github size={18} />
        </a>

        <!-- Language Picker -->
        <LanguagePicker currentLocale={locale} />

        <!-- Profile -->
        <a 
          href="/about"
          class="p-1 rounded-md text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626] transition-colors"
          aria-label="Profile"
        >
          <User size={18} />
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-[#e5e5e5] dark:border-[#404040]">
    <nav class="max-w-[1280px] mx-auto px-3 md:px-5 py-3 flex flex-col gap-1">
      {navItems.map(item => (
        <a 
          href={getNavHref(item.href)}
          class:list={[
            "px-3 py-2 text-sm font-medium rounded-md transition-colors",
            currentPath === item.href
              ? "bg-[#eef0ff] dark:bg-[#2d2d2d] text-[#3B49DF]"
              : "text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626]"
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function getStoredTheme() {
    return localStorage.getItem('theme') || 'light';
  }

  function applyTheme(mode: string) {
    if (mode === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('theme', mode);
  }

  function initTheme() {
    const saved = getStoredTheme();
    applyTheme(saved);
  }

  function toggleTheme() {
    const current = getStoredTheme();
    const next = current === 'light' ? 'dark' : 'light';
    applyTheme(next);
  }

  initTheme();

  const toggleBtn = document.getElementById('theme-toggle');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', toggleTheme);
  }

  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
