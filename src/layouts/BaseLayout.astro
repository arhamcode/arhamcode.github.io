---
import "../styles/global.css";
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { type Locale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  locale?: Locale;
  showSidebar?: boolean;
}

const { title, description, image, type, locale = 'en', showSidebar = true } = Astro.props;
---

<!DOCTYPE html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} type={type} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <ClientRouter />
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light';
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#f5f5f5] dark:bg-[#1a1a1a] text-[#171717] dark:text-white font-sans antialiased">
    <Header locale={locale} />
    
    <div class="max-w-[1280px] w-full mx-auto px-3 md:px-5">
      {showSidebar ? (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 py-6">
          <!-- Left Sidebar - Navigation -->
          <aside class="hidden lg:block lg:col-span-2">
            <nav class="sticky top-16">
              <ul class="flex flex-col gap-1">
                <li>
                  <a href={`/${locale === 'en' ? '' : locale}`} class="block px-3 py-2 text-sm font-medium rounded-md text-[#171717] dark:text-white bg-[#eef0ff] dark:bg-[#262626]">
                    Home
                  </a>
                </li>
                <li>
                  <a href={`/${locale}/blog`} class="block px-3 py-2 text-sm font-medium rounded-md text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626]">
                    Blog
                  </a>
                </li>
                <li>
                  <a href={`/${locale}/about`} class="block px-3 py-2 text-sm font-medium rounded-md text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626]">
                    About
                  </a>
                </li>
                <li>
                  <a href={`/${locale}/contact`} class="block px-3 py-2 text-sm font-medium rounded-md text-[#575757] dark:text-[#a1a1a1] hover:bg-[#f5f5f5] dark:hover:bg-[#262626]">
                    Contact
                  </a>
                </li>
              </ul>
              
              <div class="mt-6">
                <h4 class="px-3 text-xs font-bold text-[#71717a] dark:text-[#71717a] uppercase tracking-wide mb-2">My Tags</h4>
                <ul class="flex flex-col gap-1">
                  <li>
                    <a href={`/${locale}/blog/flutter`} class="block px-3 py-1.5 text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline">
                      #flutter
                    </a>
                  </li>
                  <li>
                    <a href={`/${locale}/blog/dart`} class="block px-3 py-1.5 text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline">
                      #dart
                    </a>
                  </li>
                  <li>
                    <a href={`/${locale}/blog/state-management`} class="block px-3 py-1.5 text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline">
                      #state-management
                    </a>
                  </li>
                </ul>
              </div>
            </nav>
          </aside>

          <!-- Main Content -->
          <main class="lg:col-span-7">
            <slot />
          </main>

          <!-- Right Sidebar -->
          <aside class="hidden lg:block lg:col-span-3">
            <div class="sticky top-16 space-y-6">
              <!-- Trending Tags -->
              <div class="bg-white dark:bg-[#1a1a1a] rounded-md border border-[#e5e5e5] dark:border-[#404040] p-4">
                <h3 class="font-bold text-[#171717] dark:text-white mb-3">Trending</h3>
                <ul class="flex flex-col gap-2">
                  <li>
                    <a href={`/${locale}/blog/flutter`} class="text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline">
                      #flutter
                    </a>
                  </li>
                  <li>
                    <a href={`/${locale}/blog/clean-architecture`} class="text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline">
                      #clean-architecture
                    </a>
                  </li>
                  <li>
                    <a href={`/${locale}/blog/provider`} class="text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline">
                      #provider
                    </a>
                  </li>
                  <li>
                    <a href={`/${locale}/blog/riverpod`} class="text-sm text-[#3B49DF] dark:text-[#a5b4fc] hover:underline">
                      #riverpod
                    </a>
                  </li>
                </ul>
              </div>

              <!-- Links -->
              <div class="text-xs text-[#71717a] dark:text-[#71717a]">
                <a href={`/${locale}/about`} class="hover:underline mr-3">About</a>
                <a href={`/${locale}/privacy`} class="hover:underline mr-3">Privacy</a>
                <a href={`/${locale}/terms`} class="hover:underline mr-3">Terms</a>
                <a href={`/${locale}/contact`} class="hover:underline">Contact</a>
              </div>
            </div>
          </aside>
        </div>
      ) : (
        <main class="py-6">
          <slot />
        </main>
      )}
    </div>
    
    <Footer locale={locale} />
  </body>
</html>
